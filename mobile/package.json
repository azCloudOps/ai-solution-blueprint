{
  "name": "ai-solution-blueprint-mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Google Play and App Store shell for AI Solution Blueprint. The app version comes from the root package.json.",
  "scripts": {
    "build:web": "node ../scripts/build.mjs --native",
    "assets": "capacitor-assets generate --android --ios --assetPath ../assets --iconBackgroundColor '#2F6FD6' --iconBackgroundColorDark '#0F1B2E' --splashBackgroundColor '#FFFFFF' --splashBackgroundColorDark '#0F1B2E'",
    "sync": "npm run build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  },
  "engines": { "node": ">=22" }
}
